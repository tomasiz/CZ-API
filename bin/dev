#!/usr/bin/env bash
# Environnement de dev : MySQL + API (8080) + phpMyAdmin (8081). Ctrl+C arrête tout.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PHP_BIN="${PHP_BIN:-/opt/homebrew/opt/php@8.4/bin/php}"
PMA_DIR="${PMA_DIR:-/opt/homebrew/share/phpmyadmin}"
API_PORT="${API_PORT:-8080}"
PMA_PORT="${PMA_PORT:-8081}"

[ -x "$PHP_BIN" ] || { echo "PHP 8.4 introuvable ($PHP_BIN). brew install php@8.4"; exit 1; }
[ -d "$PMA_DIR" ] || { echo "phpMyAdmin introuvable ($PMA_DIR). brew install phpmyadmin"; exit 1; }
[ -f "$ROOT/.env" ] || { echo ".env manquant : cp .env.example .env"; exit 1; }

env_get() { grep -E "^$1=" "$ROOT/.env" | head -1 | cut -d= -f2-; }
DB_NAME="$(env_get DB_NAME)"; DB_USER="$(env_get DB_USER)"; DB_PASS="$(env_get DB_PASS)"
DB_PORT="$(env_get DB_PORT)"; DB_PORT="${DB_PORT:-3306}"

# 1. MySQL
if ! mysqladmin -uroot --connect-timeout=2 ping >/dev/null 2>&1; then
  echo "→ Démarrage de MySQL…"
  brew services start mysql >/dev/null
  for _ in $(seq 1 30); do mysqladmin -uroot ping >/dev/null 2>&1 && break; sleep 1; done
fi

# 2. Base et utilisateur dédiés (idempotent). root n'est utilisé que ici, jamais par l'application.
mysql -uroot <<SQL
CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';
CREATE USER IF NOT EXISTS '$DB_USER'@'127.0.0.1' IDENTIFIED BY '$DB_PASS';
ALTER USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';
ALTER USER '$DB_USER'@'127.0.0.1' IDENTIFIED BY '$DB_PASS';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'127.0.0.1';
SQL

# 3. API et phpMyAdmin (serveur PHP intégré, loopback uniquement)
cleanup() { trap - INT TERM EXIT; kill 0 2>/dev/null || true; }
trap cleanup INT TERM EXIT

"$PHP_BIN" -S "127.0.0.1:$API_PORT" -t "$ROOT/public" >/dev/null 2>&1 &
"$PHP_BIN" -S "127.0.0.1:$PMA_PORT" -t "$PMA_DIR" >/dev/null 2>&1 &
sleep 1

cat <<MSG

  Casamiza · environnement de dev (PHP $("$PHP_BIN" -r 'echo PHP_VERSION;'))

  API         http://localhost:$API_PORT
  phpMyAdmin  http://localhost:$PMA_PORT/index.php?route=/database/structure&db=$DB_NAME
  Base        $DB_NAME  ·  utilisateur $DB_USER  ·  port $DB_PORT

  Ctrl+C pour arrêter.

MSG
wait
