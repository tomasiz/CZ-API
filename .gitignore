/vendor/
.env
/storage/logs/*
!/storage/logs/.gitkeep
# Logo de l'entreprise envoyé par l'admin : donnée d'exécution
/storage/logos/*
# PDF des factures et récapitulatifs : documents légaux et données personnelles, jamais versionnés
/storage/invoices/*
# Relevés Beyond Pricing conservés pour être retéléchargés : données d'exécution, jamais versionnées
/storage/beyond/*
# Factures Guesty (xlsx) conservées : données d'exécution, jamais versionnées
/storage/guesty/*
.vite/
.phpunit.cache/
.php-cs-fixer.cache
