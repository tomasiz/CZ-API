APP_ENV=dev
APP_URL=http://localhost:8080
# Origine unique autorisée par CORS (le front)
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=casamiza
DB_USER=casamiza
DB_PASS=change-me

# Dev : none (front et API sur des origines différentes) ; prod : strict (même domaine)
COOKIE_SAMESITE=none

# Authentification
JWT_SECRET=change-me-with-at-least-32-random-characters
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
# Plafond absolu d'une session, quelle que soit l'activité (0 = aucun plafond)
SESSION_MAX_DAYS=30
COOKIE_SECURE=true

# Chiffrement des secrets tiers (Guesty, Mailsend…) : 32 octets en base64.
# Générer : php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"  (ne jamais changer sans rechiffrer la base)
APP_ENCRYPTION_KEY=
